# Discord bot token from https://discord.com/developers/applications
TOKEN=

# Name the bot uses when it refers to itself. The Discord username and avatar
# are changed in the Discord Developer Portal instead.
BOT_NAME=Caffeinator

# Server or community the bot belongs to.
COMMUNITY_NAME=The Coffee Break

# Optional channel ID for startup notifications
CHANNEL_ID=

# Logging: text locally, json on Railway (auto-detected)
# LOG_FORMAT=json

# OpenRouter key. Required.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# App URL sent to OpenRouter for attribution. Point it at your fork if you have one.
# OPENROUTER_APP_URL=https://github.com/metruzanca/caffeinator

# Web search
OPENROUTER_WEB_SEARCH=true
OPENROUTER_WEB_SEARCH_MAX_RESULTS=3
OPENROUTER_WEB_SEARCH_MAX_USES=2

# Chat tuning
CHAT_ENABLED=true
# Optional override. Defaults to a stack-aware peer-tone prompt with simple sentences, no em dashes, and a 280-character reply limit.
# CHAT_SYSTEM_PROMPT=
CHAT_CONTEXT_MESSAGES=10
CHAT_MAX_TOKENS=2048

# Markdown memory
# On Railway, mount a volume at /data and use /data/memory.
MEMORY_ENABLED=true
MEMORY_DIR=./memory
MEMORY_MAX_CONTEXT_CHARS=3000
MEMORY_MIN_CONFIDENCE=0.7
MEMORY_EXTRACT_TIMEOUT_SECONDS=30
MEMORY_PASSIVE_ENABLED=true
MEMORY_BATCH_SECONDS=60
MEMORY_MAX_BATCH_MESSAGES=20
# Comma-separated channel IDs to skip for passive memory.
MEMORY_IGNORE_CHANNELS=

# Image generation
IMAGE_ENABLED=true
IMAGE_MODEL=black-forest-labs/flux-3-image-klein
IMAGE_DEFAULT_RESOLUTION=1K
IMAGE_DEFAULT_ASPECT_RATIO=1:1
IMAGE_SAFETY_TOLERANCE=2
IMAGE_MAX_REFERENCE_MB=8
IMAGE_TIMEOUT_SECONDS=120
IMAGE_RATE_LIMIT_PER_HOUR=20

# Reminders and events
# On Railway, use /data/reminders.json.
REMINDERS_ENABLED=true
REMINDERS_PATH=./reminders.json
REMINDER_TICK_SECONDS=15
REMINDER_GRACE_MINUTES=60
REMINDER_MAX_PER_USER=50
REMINDER_RETRY_MINUTES=2
REMINDER_MAX_ATTEMPTS=5

# Image understanding
VISION_ENABLED=true
VISION_MAX_IMAGES=4
VISION_MAX_IMAGE_MB=8
VISION_DETAIL=auto

# Meme memory
# Scrapes top posts, understands the images, and shares relevant memes in chat.
# Reddit blocks anonymous scraping, so REDDIT_SESSION is needed.
MEMES_ENABLED=true
# Standard 5-field cron in MEMES_TIMEZONE.
MEMES_CRON=0 15 * * 1,3,5
MEMES_TIMEZONE=UTC
MEMES_SUBREDDITS=ProgrammerHumor
MEMES_TOP_PERIOD=week
MEMES_SCAN_LIMIT=25
MEMES_POSTS_PER_RUN=5
MEMES_MAX_STORED=50
MEMES_RETENTION_DAYS=30
MEMES_RELEVANCE_LIMIT=3
MEMES_MAX_IMAGE_MB=8
# Defaults to OPENROUTER_MODEL.
# MEMES_ANALYSIS_MODEL=
MEMES_ANALYSIS_TIMEOUT_SECONDS=60
MEMES_REFRESH_TIMEOUT_SECONDS=600
# Defaults derive from MEMORY_DIR.
# MEMES_PATH=./memory/memes.json
# MEMES_DIR=./memory/memes
MEMES_INCLUDE_NSFW=false
MEMES_POSITIVE_REACTIONS=😂,🤣,💀,🔥,👍,❤️,😆

# Reddit session cookie from a logged-in browser. Required for meme memory.
# See docs/memes.md for the steps.
REDDIT_SESSION=
# REDDIT_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0
